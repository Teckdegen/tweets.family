# Website (Vercel) environment. The bot has its own list in bot/env.example.

# "Sign in with X": OAuth 2.0 client from the X developer portal (User authentication settings).
# Register this callback URL there: https://tweetsfamily.vercel.app/api/auth/x/callback
# (and http://localhost:3000/api/auth/x/callback for local dev)
X_CLIENT_ID=
X_CLIENT_SECRET=

# signs the login cookie. generate with: npm run wallet-key
SESSION_SECRET=

# optional: force the site's public URL (used to build the X callback URL)
SITE_URL=

# same Supabase project as the bot. server-side only, never exposed to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# for reading users' USDG balances. TOKEN_ADDRESS must match the bot's
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
TOKEN_ADDRESS=

# NOTE: WALLET_KEY is NOT needed here and should never be set on the website.
