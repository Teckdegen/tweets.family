BEARER_TOKEN=
BOT_USERNAME=tweetscc
BOT_USER_ID=
BOT_ACCESS_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
BOT_REFRESH_TOKEN=
POLL_MS=5000
MAX_STAKE=1000
REQUIRE_ACCOUNT=true
SITE_URL=tweetsfamily.vercel.app
CREATORS=nova,mira,rio
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# master secret: every user's deposit address is derived from it. never change it once live.
WALLET_KEY=
# optional: your own house wallet key. if empty, the house wallet is derived from WALLET_KEY
HOUSE_PRIVATE_KEY=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# the USDG contract on Robinhood Chain (required). users deposit and bet with this token
TOKEN_ADDRESS=
TOKEN_SYMBOL=USDG
# fallback only; the real value is read from the token contract at startup
TOKEN_DECIMALS=6
# deposit/withdrawal history: first block to scan on the very first run (default: current block)
EVENTS_START_BLOCK=
LOG_CHUNK=2000
